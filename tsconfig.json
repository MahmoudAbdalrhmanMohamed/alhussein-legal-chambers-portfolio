{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "resuxjs"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "env.d.ts",
    "types/**/*",
    "resux.config.ts",
    "pages/**/*",
    "layouts/**/*",
    "plugins/**/*",
    "components/**/*",
    "composables/**/*",
    "server/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".resux"
  ]
}
